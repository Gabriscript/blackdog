<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- =====================================================================
       BLACK DOG - Sala Prove a Firenze (.NET 10 LTS backend)
       ASP.NET Core Web API + Entity Framework Core + PostgreSQL
       ===================================================================== -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BlackDog.Api</RootNamespace>
    <AssemblyName>BlackDog.Api</AssemblyName>
    <UserSecretsId>7192d074-4ef5-44bc-8ae9-1a3a393fcb1f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Entity Framework Core (PostgreSQL) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />

    <!-- JWT auth (System.IdentityModel.Tokens.Jwt comes with it, same version) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Resend" Version="0.5.1" />

    <!-- Password hashing -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />

    <!-- Stripe -->
    <PackageReference Include="Stripe.net" Version="47.4.0" />

    <!-- Swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
  </ItemGroup>

</Project>
