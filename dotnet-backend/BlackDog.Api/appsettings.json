    "DefaultConnection": "Host=localhost;Port=5432;Database=blackdog;Username=blackdog;Password=blackdog"
  },

  "//SECRETS": [
    "I valori vuoti qui sotto NON vanno riempiti in questo file: finisce su git.",
    "In locale:      dotnet user-secrets set \"Jwt:Secret\" \"...\"  (dalla cartella BlackDog.Api)",
    "In produzione:  variabili d'ambiente, doppio underscore -> Jwt__Secret, Admin__Password, Resend__ApiToken",
    "L'app non parte se Jwt:Secret o Admin:Password mancano: e' voluto, meglio di un default indovinabile."
  ],

  "Jwt": {
    "Secret": "",
    "ExpiresMinutes": 1440
  },

